rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    match /users/{uid} {
      allow read: if owner(uid);
      allow create: if owner(uid) && request.resource.data.keys().hasOnly(['preferences']);
      allow update: if owner(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['preferences']);
      allow delete: if false;
      match /purchases/{purchase} { allow read: if owner(uid); allow write: if false; }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
