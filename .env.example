# ============================================================================
# ARGON SQUASH — operator-level tuning (copy to .env; never committed)
# Vite exposes VITE_* vars to the client bundle. AI tuning values are optional;
# the account bindings below are required for purchase/account activation.
# Probabilities are 0..1. Never put provider secrets into VITE_* variables.
# ============================================================================

# --- AI serve errors (probability per AI serve) ---
VITE_SA_AI_SERVE_WRONG_BOX_CHANCE=0.04
VITE_SA_AI_SERVE_SELF_CORRECT_CHANCE=0.55
VITE_SA_AI_SERVE_FOOT_FAULT_CHANCE=0.001

# --- AI behavior probabilities / strengths ---
VITE_SA_AI_AGGRESSION=0.55
VITE_SA_AI_ANTICIPATION=0.68
VITE_SA_AI_FRONT_COURT_CREEP=0.38
VITE_SA_AI_REACTION_DELAY_MS=195

# --- Firebase application identity (public Firebase web-app configuration) ---
# Obtain this complete set from the configured production Firebase web app.
# VITE_FIREBASE_PROJECT_ID is configurable; project selection is not hardcoded.
# These identify the app; authorization still requires Auth and server checks.
# Installation-specific values are intentionally empty in this portable example.
# Internal live files use the canonical configuration pointers; the authorized
# launcher resolves them into its process environment before Vite starts.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# --- Account service and native browser sign-in ---
# HTTPS base URL of the deployed account API; no trailing endpoint path.
# Purpose: catalog, verified access, checkout, restore and purchase documents.
VITE_SQUASH_API_BASE_URL=
# HTTPS URL of the deployed account-auth.html entry, used for native sign-in.
# Must be on an actual Firebase-authorized domain, not the native WebView origin.
VITE_ACCOUNT_AUTH_URL=

# --- Catalog provisioning defaults (USD major units, not checkout prices) ---
# Intended launch prices for creating the real provider catalog. These defaults
# do not create products and must never replace provider-localized prices in UI.
# Monthly, six-month and annual renew; lifetime is one non-consumable purchase.
# These are configurable launch defaults, not claimed research findings.
SQUASH_PRICE_CURRENCY=USD
SQUASH_PRICE_MONTHLY=0.99
SQUASH_PRICE_SIX_MONTH=3.99
SQUASH_PRICE_ANNUAL=5.99
SQUASH_PRICE_LIFETIME=9.99
# Provider product IDs, Stripe secrets and Play publisher configuration belong
# in the annotated functions/.env.example schema and canonical internal entries.
# Never project those server credentials into the frontend.
