# ============================================================================
# ARGON SQUASH — operator-level tuning (copy to .env; never committed)
# Vite exposes only VITE_* vars to the client bundle. All values are optional —
# omit a key and the shipped default applies. Probabilities are 0..1.
# ============================================================================

# --- AI serve errors (probability per AI serve) ---
VITE_SA_AI_SERVE_WRONG_BOX_CHANCE=0.04
VITE_SA_AI_SERVE_SELF_CORRECT_CHANCE=0.55
VITE_SA_AI_SERVE_FOOT_FAULT_CHANCE=0.001

# --- AI behavior probabilities / strengths ---
VITE_SA_AI_AGGRESSION=0.55
VITE_SA_AI_ANTICIPATION=0.68
VITE_SA_AI_FRONT_COURT_CREEP=0.38
VITE_SA_AI_REACTION_DELAY_MS=195
