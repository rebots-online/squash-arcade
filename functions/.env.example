# Billing Functions runtime schema. Values below are intentionally empty until the
# real project, merchant, products and permitted application URLs are selected.
# Deployment must resolve internal credential pointers into the runtime; never
# publish credentials or copy them into a checked-in configuration file.

# Stripe production secret and webhook signature key. Server only.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Existing active Stripe Price IDs: one-month, six-month, one-year recurring,
# and one-time lifetime respectively. Server validates actual provider periods.
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_SIX_MONTH=
STRIPE_PRICE_ANNUAL=
STRIPE_PRICE_LIFETIME=

# Fixed HTTPS application return URLs. Checkout completion never grants access.
CHECKOUT_SUCCESS_URL=
CHECKOUT_CANCEL_URL=
BILLING_RETURN_URL=
# Hosted account-auth.html URL, used by native system-browser sign-in.
ACCOUNT_AUTH_URL=
# Comma-separated exact browser and native WebView origins permitted by API CORS.
BILLING_ALLOWED_ORIGINS=

# Actual production Android application ID; must match the Play listing.
PLAY_PACKAGE_NAME=
# Three subscription base plans belong to this one product; lifetime is INAPP.
PLAY_SUBSCRIPTION_PRODUCT_ID=
PLAY_BASE_PLAN_MONTHLY=
PLAY_BASE_PLAN_SIX_MONTH=
PLAY_BASE_PLAN_ANNUAL=
PLAY_LIFETIME_PRODUCT_ID=
# Public actual store listing URL; omitted until the listing exists.
PLAY_LISTING_URL=
# Exact OIDC audience, authenticated Pub/Sub service-account email, and full
# projects/{project}/subscriptions/{subscription} resource for RTDN push.
PLAY_PUSH_AUDIENCE=
PLAY_PUSH_SERVICE_ACCOUNT=
PLAY_PUBSUB_SUBSCRIPTION=

# Google Publisher API uses the deployed Functions service account via ADC.
# Grant that selected identity access in Play Console; no private-key JSON is
# accepted or projected to the client by this module. Project selection belongs
# to the explicit deploy invocation, not an invented default project here.
